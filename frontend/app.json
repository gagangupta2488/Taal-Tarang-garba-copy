{
  "expo": {
    "name": "Taal Tarang Garba",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.taaltaranggarba.nql448",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload a photo for your Garba pass",
        "NSCameraUsageDescription": "Capture your photo for the Garba pass"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B132B"
      },
      "package": "com.emergent.taaltaranggarba.nql448",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B132B"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload a photo for your Garba pass",
          "cameraPermission": "Capture your photo for the Garba pass"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
